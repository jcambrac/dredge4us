# Base URL of the poller's API (server/cmd/api). Server-side only —
# never prefix this with NEXT_PUBLIC_, the browser never calls it
# directly.
API_BASE_URL=http://localhost:8090

# Bearer token sent as "Authorization: Bearer <value>" on every request
# to API_BASE_URL. Must match that server's API_AUTH_TOKEN.
API_AUTH_TOKEN=change-me
