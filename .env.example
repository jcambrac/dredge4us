# Postgres connection string for the poller.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Bearer token server/cmd/api requires on every request (see
# server/internal/api's withAuth). Must match frontend/.env's
# API_AUTH_TOKEN for the Next.js proxy routes to authenticate.
API_AUTH_TOKEN=change-me

# Comma-separated board:interval pairs. Optional — defaults to "g:20s".
# POLLER_BOARDS=g:20s,biz:20s

# Worker pool size. Optional — defaults to 2.
# POLLER_WORKERS=2

# Production only (deploy/docker-compose.yml): hostname nginx serves the
# API on and requests a Let's Encrypt cert for. Must resolve to the
# droplet — the sslip.io form works without owning a domain.
# API_DOMAIN=134-199-211-6.sslip.io

# LLM model for the summarizer and the api's /debug/classify.
# Optional — defaults to gpt-5.5.
# OPENAI_MODEL=gpt-5.5
